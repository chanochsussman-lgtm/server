{
  "type": "music",
  "domain": "twentyfoursix",
  "name": "24Six",
  "description": "24Six Jewish music streaming provider for Music Assistant",
  "codeowners": ["@your-github-username"],
  "requirements": ["aiohttp>=3.9.0"],
  "config_entries": [
    {
      "key": "username",
      "type": "string",
      "label": "Email / Username",
      "required": true,
      "description": "Your 24Six account email address"
    },
    {
      "key": "password",
      "type": "secure_string",
      "label": "Password",
      "required": true,
      "description": "Your 24Six account password"
    }
  ],
  "documentation": "https://www.24six.app",
  "multi_instance": false,
  "icon": "https://24six.app/favicon.ico"
}
